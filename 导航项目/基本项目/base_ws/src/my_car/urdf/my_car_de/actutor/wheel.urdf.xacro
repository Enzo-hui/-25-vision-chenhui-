<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find my_car)/urdf/my_car_de/common_inertia.xacro" />
    <xacro:macro name="wheel" params="wheel_name xyz">
        <link name="${wheel_name}">
            <visual>
                <origin xyz="0 0 0" rpy="1.57079 0 0" />
                <geometry>
                    <cylinder radius="0.03" length="0.04" />
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57079 0 0" />
                <geometry>
                    <cylinder radius="0.03" length="0.04" />
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0" />
                </material>
            </collision>
            <xacro:cylinder_inertia m="3.0" r="0.03" h="0.04" />
        </link>
        <joint name="${wheel_name}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0" />
            <parent link="base_link" />
            <child link="${wheel_name}" />
            <axis xyz="0.0 1 0.0" />
        </joint>

        <gazebo reference="${wheel_name}">
            <mu1 value="20.0"/>
            <mu2 value="20.0"/>
            <kp value="100000000.0"/>
            <kd value="1.0"/>
        </gazebo>
    </xacro:macro>
</robot>