<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:include filename="$(find my_car)/urdf/my_car_de/common_inertia.xacro"/>
    <xacro:macro name="base_link" params="length radius">
        <link name="base_link">
            <visual>
                <origin xyz="0 0 0.09" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${length}" length="${radius}" />
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 0.5" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0.09" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${length}" length="${radius}" />
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 0.5" />
                </material>
            </collision>
            <xacro:cylinder_inertia m="1.0" r="${radius}" h="${length}"/>
        </link>
        <!-- <link name="base_footprint">
            <collision>
                <origin xyz="0 0 0" rpy="1.57079 0 0" />
                <geometry>
                    <cylinder radius="0.03" length="0.04" />
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0" />
                </material>
            </collision>
        </link>

        <joint name="joint_name" type="fixed">
            <origin xyz="0.0 0.0 0.075" rpy="0.0 0.0 0.0"/>
            <parent link="base_footprint"/>
            <child link="base_link"/>
        </joint> -->
    
    </xacro:macro>
</robot>