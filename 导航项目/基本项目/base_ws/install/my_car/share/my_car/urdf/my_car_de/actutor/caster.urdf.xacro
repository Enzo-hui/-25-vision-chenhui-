<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find my_car)/urdf/my_car_de/common_inertia.xacro" />
    <xacro:macro name="caster" params="radius xyz">
        <link name="caster_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                        <sphere radius="${radius}"/>
                </geometry>
                <material name="white">
                    
                        <color rgba="1.0 1.0 1.0 1.0" />
                   
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57079 0 0" />
                <geometry>
                    <sphere radius="${radius}"/>
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0" />
                </material>
            </collision>
            <xacro:cylinder_inertia m="1.0" r="0.03" h="0.04"/>
        </link>
        <joint name="caster_joint" type="fixed">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0" />
            <parent link="base_link" />
            <child link="caster_link" />
        </joint>
        <gazebo reference="caster_link">
            <mu1 value="0.0"/>
            <mu2 value="0.0"/>
            <kp value="100000000.0"/>
            <kd value="1.0"/>
        </gazebo>
    </xacro:macro>
</robot>